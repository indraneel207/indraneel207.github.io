# Optional: only needed for npm run refresh:data.
# npm start and npm run build use the committed JSON snapshots.
# Copy this file to .env and keep .env out of Git.

GITHUB_TOKEN="YOUR GITHUB TOKEN HERE"
GITHUB_USERNAME="YOUR GITHUB USERNAME HERE"
# Set to false to skip GitHub when refreshing all configured sources.
USE_GITHUB_DATA="true"
# Set to your Medium username, or leave empty to skip Medium refreshes.
MEDIUM_USERNAME=""
