---
import type {CollectionEntry} from "astro:content";
import Icon from "./Icon.astro";
import ProjectVisual from "./ProjectVisual.astro";

interface Props {
  project: CollectionEntry<"work">;
}
const {project} = Astro.props;
---

<article class="project-card">
  <div class="project-card-preview">
    <ProjectVisual visual={project.data.visual} />
  </div>
  <div class="project-card-meta mono">
    <span>
      {String(project.data.order).padStart(2, "0")} /{" "}
      {project.data.client.toUpperCase()}
    </span>
    <span>{project.data.category}</span>
  </div>
  <h3>
    <a href={`/work/${project.id}/`} data-project={project.id}>
      <span class="sr-only">Explore </span>
      {project.data.shortTitle}
      <span class="project-open-icon">
        <Icon name="diagonal" size={25} />
      </span>
    </a>
  </h3>
  <p>{project.data.summary}</p>
  <ul class="project-tags" aria-label="Technologies">
    {project.data.tags.slice(0, 3).map(tag => (
      <li>{tag}</li>
    ))}
  </ul>
</article>
