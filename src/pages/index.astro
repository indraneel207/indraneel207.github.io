---
import {getCollection} from "astro:content";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import ProjectExplorer from "../components/ProjectExplorer";
import DataVisual from "../components/DataVisual.astro";
import ImpactMetrics from "../components/ImpactMetrics.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Recommendations from "../components/Recommendations.astro";
import {
  profile,
  experience,
  capabilities,
  experiments,
  credentials,
  research,
  achievement,
  community
} from "../data/profile";

const projects = (await getCollection("work")).sort(
  (a, b) => a.data.order - b.data.order
);
const featured = projects.filter(project => project.data.featured);
const supporting = projects.filter(project => !project.data.featured);
const lead = featured[0];
---

<Base>
  <section class="hero shell" aria-labelledby="hero-title">
    <div class="hero-copy">
      <div class="eyebrow">
        <span class="small-star" aria-hidden="true">
          ✳
        </span>{" "}
        SOFTWARE ENGINEER, WITH CRAFT
      </div>
      <h1 id="hero-title">
        Complex problems.
        <br />
        Thoughtful
        <br />
        <em>software.</em>
      </h1>
      <p class="hero-description">{profile.introduction}</p>
      <div class="hero-actions">
        <a class="button button-primary" href="#work">
          Explore my work <Icon name="arrow" />
        </a>
        <a
          class="text-link"
          href={profile.resume}
          target="_blank"
          rel="noopener noreferrer"
        >
          View résumé <Icon name="diagonal" size={17} />
          <span class="sr-only"> (opens in a new tab)</span>
        </a>
      </div>
      <div class="hero-meta">
        <span>
          <span class="location-dot" aria-hidden="true" /> {profile.location}
        </span>
        <span>Platform engineering · Research software</span>
      </div>
    </div>
    <div class="hero-art">
      <div class="handwritten-note">
        A little of what’s behind the screen{" "}
        <svg
          viewBox="0 0 90 44"
          width="68"
          height="34"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M2 4C31-4 51 8 56 29m-13-8 14 12 10-17"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
          />
        </svg>
      </div>
      <ProjectExplorer client:load />
      <div class="hero-figure">
        <span class="mono">FIG. 01 / INTERFACE MEETS INFRASTRUCTURE</span>
        <span class="figure-spark" aria-hidden="true">
          ✳
        </span>
      </div>
    </div>
  </section>

  <div class="credibility shell">
    <span class="mono">A FEW STOPS ALONG THE WAY</span>
    <div>
      <span class="company-vanguard">Vanguard</span>
      <span class="company-actyv">
        actyv<span>.ai</span>
      </span>
      <span class="company-asu">
        ASU{" "}
        <span>
          Arizona State
          <br />
          University
        </span>
      </span>
      <span class="company-xebia">
        xebia<span>.</span>
      </span>
    </div>
  </div>

  <section
    class="work-section section shell"
    id="work"
    aria-labelledby="work-title"
  >
    <div class="section-heading">
      <div>
        <p class="eyebrow">01 / SELECTED WORK</p>
        <h2 id="work-title">
          Built with purpose.
          <br />
          <em>Made to be used.</em>
        </h2>
      </div>
      <p>
        A selection of products, platforms, and websites — and the thinking that
        connects them.
      </p>
    </div>
    <article class="featured-project">
      <div class="featured-copy">
        <div class="project-kicker mono">
          <span>01 / VANGUARD</span>
          <span>{lead.data.category.toUpperCase()}</span>
        </div>
        <h3>{lead.data.title}</h3>
        <p>{lead.data.summary}</p>
        <ul class="project-tags" aria-label="Technologies">
          {lead.data.tags
            .filter(tag =>
              ["React", "TypeScript", "Module Federation", "AWS"].includes(tag)
            )
            .map(tag => (
              <li>{tag}</li>
            ))}
        </ul>
        <a
          class="button button-cream"
          href={`/work/${lead.id}/`}
          data-project={lead.id}
        >
          Explore the work <Icon name="arrow" />
        </a>
        <span class="featured-caption mono">
          APPLICATIONS → SHARED PLATFORMS → AUTOMATION
        </span>
      </div>
      <div class="featured-visual">
        <DataVisual />
      </div>
    </article>
    {lead.data.impact && <ImpactMetrics items={lead.data.impact} />}
    <div class="project-grid">
      {featured.slice(1).map(project => (
        <ProjectCard project={project} />
      ))}
    </div>
  </section>

  <section
    class="experience-section section"
    id="experience"
    aria-labelledby="experience-title"
  >
    <div class="shell experience-layout">
      <div class="experience-intro">
        <p class="eyebrow">02 / THE JOURNEY</p>
        <h2 id="experience-title">
          Different teams.
          <br />A shared thread:
          <br />
          <em>building well.</em>
        </h2>
        <p>
          From early-stage product teams to enterprise platforms, I like working
          where thoughtful interfaces meet real engineering challenges.
        </p>
        <a
          class="text-link"
          href={profile.resume}
          target="_blank"
          rel="noopener noreferrer"
        >
          The full story, on my résumé <Icon name="diagonal" size={17} />
        </a>
      </div>
      <div class="experience-list">
        {experience.map((job, index) => (
          <article class="experience-item">
            <div class="timeline-marker" aria-hidden="true">
              {index === 0 ? <span /> : <i />}
            </div>
            <div class="experience-top">
              <h3>{job.company}</h3>
              <span class="mono">{job.period}</span>
            </div>
            <p class="experience-role">{job.role}</p>
            <p class="experience-location mono">{job.location}</p>
            <p class="experience-description">{job.description}</p>
            {job.highlights.length > 0 && (
              <ul class="experience-highlights">
                {job.highlights.map(highlight => (
                  <li>{highlight}</li>
                ))}
              </ul>
            )}
            {job.progression && (
              <details class="progression">
                <summary>
                  See the progression <span aria-hidden="true">+</span>
                </summary>
                <ol>
                  {job.progression.map(step => (
                    <li>
                      <strong>{step.role}</strong>
                      <span class="mono">{step.dates}</span>
                    </li>
                  ))}
                </ol>
              </details>
            )}
            <ul class="project-tags" aria-label="Areas of work">
              {job.tags.map(tag => (
                <li>{tag}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section
    class="capabilities-section section shell"
    aria-labelledby="capabilities-title"
  >
    <div class="compact-section-heading">
      <p class="eyebrow">THE TOOLKIT</p>
      <h2 id="capabilities-title">
        Good tools. <em>Better questions.</em>
      </h2>
    </div>
    <div class="capability-grid">
      {capabilities.map(capability => (
        <article>
          <span class="capability-number mono">/{capability.number}</span>
          <h3>{capability.title}</h3>
          <p>{capability.description}</p>
          <span class="capability-tools mono">{capability.tools}</span>
        </article>
      ))}
    </div>
  </section>

  <section
    class="lab-section section shell"
    id="more-work"
    aria-labelledby="lab-title"
  >
    <div class="section-heading">
      <div>
        <p class="eyebrow">03 / MORE TO EXPLORE</p>
        <h2 id="lab-title">
          More ways <em>to build.</em>
        </h2>
      </div>
      <p>
        AI prototypes, research websites, and experiments beyond the day job.
      </p>
    </div>
    <div class="project-grid supporting-projects">
      {supporting.map(project => (
        <ProjectCard project={project} />
      ))}
    </div>
    <div class="experiment-list">
      {experiments.map(experiment => (
        <a
          class="experiment"
          href={experiment.url}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="experiment-number mono">{experiment.number}</span>
          <div class="experiment-title">
            <h3>{experiment.title}</h3>
            <span class="mono">{experiment.category}</span>
          </div>
          <p>{experiment.description}</p>
          <span class="experiment-arrow">
            <Icon name="diagonal" size={24} />
            <span class="sr-only">
              View source on GitHub (opens in a new tab)
            </span>
          </span>
        </a>
      ))}
    </div>
    <a
      class="text-link github-more"
      href={profile.github}
      target="_blank"
      rel="noopener noreferrer"
    >
      More from my GitHub <Icon name="diagonal" size={17} />
    </a>
  </section>

  <section
    class="about-section section"
    id="about"
    aria-labelledby="about-title"
  >
    <div class="shell about-layout">
      <div class="about-art">
        <div class="about-notebook">
          <span class="mono">A NOTE TO BUILD BY</span>
          <span class="notebook-star" aria-hidden="true">
            ✳
          </span>
          <p>
            Stay curious.
            <br />
            Make it useful.
            <br />
            <em>Care about the details.</em>
          </p>
          <span class="notebook-signature">— Indraneel</span>
          <div class="notebook-bottom mono">
            <span>CODE + CURIOSITY</span>
            <span>EST. / ALWAYS LEARNING</span>
          </div>
        </div>
      </div>
      <div class="about-copy">
        <p class="eyebrow">04 / THE PERSON BEHIND THE CODE</p>
        <h2 id="about-title">
          An engineer.
          <br />A tinkerer.
          <br />
          <em>Always a student.</em>
        </h2>
        {profile.biography.map(paragraph => (
          <p>{paragraph}</p>
        ))}
        <a
          class="research-note"
          href={research.publication}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="mono">PUBLISHED RESEARCH / {research.year}</span>
          <strong>
            {research.title} · {research.journal}
            <Icon name="diagonal" size={17} />
          </strong>
          <span>{research.contribution}</span>
        </a>
        <a
          class="achievement-note"
          href={achievement.source}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="mono">PROBLEM SOLVING / {achievement.year}</span>
          <strong>
            {achievement.title} <Icon name="diagonal" size={15} />
          </strong>
        </a>
        <div class="education-note">
          <span class="mono">THE FOUNDATIONS</span>
          <strong>MS, Computer Science</strong>
          <span>Arizona State University · 2022–2024 · GPA 3.93</span>
          <strong>B.Tech, Computer Science & Engineering</strong>
          <span>JNTU Hyderabad · 2016–2020</span>
        </div>
        <details class="credentials">
          <summary>
            Selected certifications <span aria-hidden="true">+</span>
          </summary>
          <ul>
            {credentials.map(credential => (
              <li>
                <a
                  href={credential.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span>
                    {credential.title}
                    <small>{credential.issuer}</small>
                  </span>
                  <Icon name="diagonal" size={17} />
                </a>
              </li>
            ))}
          </ul>
        </details>
        <details class="credentials community">
          <summary>
            Community & leadership <span aria-hidden="true">+</span>
          </summary>
          <p class="community-intro">
            Volunteering in community health and education, alongside campus
            coordination for social-service initiatives.
          </p>
          <ul>
            {community.map(entry => (
              <li>
                <a
                  href={profile.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span>
                    {entry.role} · {entry.organization}
                    <small>{entry.period}</small>
                  </span>
                  <Icon name="diagonal" size={17} />
                </a>
              </li>
            ))}
          </ul>
        </details>
      </div>
    </div>
    <Recommendations />
  </section>

  <section
    class="contact-section section shell"
    id="contact"
    aria-labelledby="contact-title"
  >
    <div class="contact-top">
      <p class="eyebrow">05 / NEXT CHAPTER</p>
      <span class="contact-spark" aria-hidden="true">
        ✳
      </span>
    </div>
    <h2 id="contact-title">
      Good things start
      <br />
      with a <em>conversation.</em>
    </h2>
    <div class="contact-bottom">
      <p>
        Have a role, a problem to solve, or an interesting idea?
        <br />
        I’d be happy to hear about it.
      </p>
      <div class="contact-email">
        <a href={`mailto:${profile.email}`}>
          {profile.email}
          <Icon name="diagonal" size={28} />
        </a>
        <button
          class="icon-button"
          type="button"
          data-copy-email={profile.email}
          aria-label="Copy email address"
          hidden
        >
          <Icon name="copy" size={20} />
        </button>
        <span
          class="copy-status"
          data-copy-status
          role="status"
          aria-live="polite"
        ></span>
      </div>
    </div>
    <div class="contact-socials">
      <a href={profile.linkedin} target="_blank" rel="noopener noreferrer">
        LinkedIn <Icon name="diagonal" size={16} />
      </a>
      <a href={profile.github} target="_blank" rel="noopener noreferrer">
        GitHub <Icon name="diagonal" size={16} />
      </a>
      <a href={profile.resume} target="_blank" rel="noopener noreferrer">
        Résumé <Icon name="diagonal" size={16} />
      </a>
    </div>
  </section>
</Base>
