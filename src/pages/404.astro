---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
---

<Base
  title="Page not found — Indraneel Vairagare"
  description="That page has moved or does not exist. Explore Indraneel Vairagare's selected engineering work."
>
  <section class="not-found shell">
    <p class="eyebrow">404 / A SMALL DETOUR</p>
    <h1>
      Nothing here.
      <br />
      <em>Plenty to explore.</em>
    </h1>
    <p>
      This page may have moved, or the link may be incomplete. Let’s get you
      back to the work.
    </p>
    <a class="button button-primary" href="/#work">
      Explore selected work <Icon name="arrow" />
    </a>
  </section>
</Base>
